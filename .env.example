# Public site URL used for canonical links, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nexrad.org

# URL of the NEXRAD application sign-in page (header "Connexion" link).
NEXT_PUBLIC_APP_URL=https://nexrad.org

# Optional: webhook that receives demo requests as JSON (CRM, Zapier, Make, n8n...).
# When empty, demo requests are validated and logged server-side only.
DEMO_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>" to the webhook.
DEMO_WEBHOOK_TOKEN=
